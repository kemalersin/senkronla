            "body": {
              "mode": "raw",
              "raw": "{\n  \"pairingCode\": \"{{pairingCode}}\",\n  \"deviceLabel\": \"{{deviceLabelGuest}}\",\n  \"clientDeviceId\": \"{{guestClientDeviceId}}\"\n}",
