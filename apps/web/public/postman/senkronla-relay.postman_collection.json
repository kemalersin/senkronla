        {
          "name": "Revoke device",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/devices/{{guestDeviceId}}",
            "description": "Removes a paired device. The last remaining device cannot be revoked.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Device revoked', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "description": "Removes a paired device. The last remaining device cannot be revoked."
        }
      ]
    },
    {
      "name": "Recovery",
      "item": [
        {
          "name": "Recover namespace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/recover",
            "description": "**Warning:** revokes every existing device token in the workspace. Uses recovery key proof, not the raw phrase.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recoveryKeyProof\": {\n    \"salt\": \"{{recoverySalt}}\",\n    \"hash\": \"{{recoveryHash}}\"\n  },\n  \"deviceLabel\": \"{{deviceLabelRecovery}}\",\n  \"clientDeviceId\": \"{{recoveryClientDeviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Namespace recovered', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('deviceToken', json.deviceToken);",
                  "    pm.environment.set('deviceId', json.deviceId);",
                  "});"
                ]
              }
            }
          ],
          "description": "**Warning:** revokes every existing device token in the workspace. Uses recovery key proof, not the raw phrase."
        }
      ]
    },
    {
      "name": "Limits & unlock",
      "item": [
        {
          "name": "Get limits",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/limits",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Redeem unlock code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/unlock",
            "description": "Operator-generated unlock code adds purchased device slots.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unlockCode\": \"{{unlockCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Operator-generated unlock code adds purchased device slots."
        }
      ]
    },
    {
      "name": "WebSocket",
      "item": [
        {
          "name": "Connect to notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Sec-WebSocket-Protocol",
                "value": "esr-notifications-v1"
              }
            ],
            "url": "{{relayWsBaseUrl}}/namespaces/{{namespaceId}}/notifications",
            "description": "WebSocket upgrade for `head_changed` and `limits_changed` events.\n\nIn Postman: switch protocol to **WebSocket**, set header `Sec-WebSocket-Protocol: esr-notifications-v1`, and send the same `Authorization: Bearer {{deviceToken}}` header.\n\nAfter `auth_ok`, optionally send:\n```json\n{ \"type\": \"subscribe\", \"documentIds\": [\"primary\", \"notes\"] }\n```\n\nAlways fetch document data over HTTP (`GET .../head`) — notifications carry metadata only.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "WebSocket upgrade for `head_changed` and `limits_changed` events.\n\nIn Postman: switch protocol to **WebSocket**, set header `Sec-WebSocket-Protocol: esr-notifications-v1`, and send the same `Authorization: Bearer {{deviceToken}}` header.\n\nAfter `auth_ok`, optionally send:\n```json\n{ \"type\": \"subscribe\", \"documentIds\": [\"primary\", \"notes\"] }\n```\n\nAlways fetch document data over HTTP (`GET .../head`) — notifications carry metadata only."
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "relayOrigin",
      "value": "http://localhost:8080"
    },
    {
      "key": "relayBaseUrl",
      "value": "{{relayOrigin}}/v1"
    },
    {
      "key": "relayWsBaseUrl",
      "value": "ws://localhost:8080/v1"
    }
  ]
}
