{
  "info": {
    "_postman_id": "6969b258-ff52-4fd5-85bd-fc1ee6e9ac47",
    "name": "Senkronla Relay API v1",
    "description": "Runnable Postman collection for the Senkronla Envelope Sync Relay REST API (`/v1`).\n\n**Setup**\n1. Import `senkronla-relay-local.postman_environment.json` (or the production template).\n2. Set `relayOrigin` to your relay host (default: `http://localhost:8080`).\n3. Run **Quick start** folder in order, or use the pre-filled sample variables for read-only requests.\n\nCollection auth uses `{{deviceToken}}`. Unauthenticated routes override auth per request.\n\nDocs: https://senkronla.dev/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{deviceToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Quick start (run in order)",
      "description": "Minimal happy-path flow: health → create namespace → list → push → poll → pull.",
      "item": [
        {
          "name": "1. Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{relayOrigin}}/health",
            "description": "Relay health — no authentication required.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Relay is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "description": "Relay health — no authentication required."
        },
        {
          "name": "2. Create namespace (first device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{relayBaseUrl}}/namespaces",
            "description": "Creates a workspace and returns the first device token. Run this before authenticated requests, or use the pre-filled sample token in the environment.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"namespaceId\": \"{{namespaceId}}\",\n  \"namespaceLabel\": \"{{namespaceLabel}}\",\n  \"deviceLabel\": \"{{deviceLabelHost}}\",\n  \"clientDeviceId\": \"{{clientDeviceId}}\",\n  \"recoveryKeyProof\": {\n    \"salt\": \"{{recoverySalt}}\",\n    \"hash\": \"{{recoveryHash}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Namespace created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.deviceToken).to.be.a('string');",
                  "    pm.environment.set('namespaceId', json.namespaceId);",
                  "    pm.environment.set('deviceToken', json.deviceToken);",
                  "    pm.environment.set('deviceId', json.deviceId);",
                  "});"
                ]
              }
            }
          ],
          "description": "Creates a workspace and returns the first device token. Run this before authenticated requests, or use the pre-filled sample token in the environment."
        },
        {
          "name": "3. List documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/documents",
            "description": "Lists all document heads in the namespace.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Documents listed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().documents).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "description": "Lists all document heads in the namespace."
        },
        {
          "name": "4. Push document — first (notes)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/documents/notes",
            "description": "First push for a non-primary document. `expectedRevision` must be null.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedRevision\": null,\n  \"envelope\": {\n    \"magic\": \"ESR-DOC1\",\n    \"schemaVersion\": 2,\n    \"namespaceId\": \"{{namespaceId}}\",\n    \"namespaceLabel\": \"{{namespaceLabel}}\",\n    \"documentId\": \"notes\",\n    \"revision\": \"{{notesRevision}}\",\n    \"deviceId\": \"{{deviceId}}\",\n    \"writtenAt\": \"{{notesWrittenAt}}\",\n    \"contentType\": \"application/vnd.example.notes+json\",\n    \"contentMagic\": \"ENV-ENC1\",\n    \"contentSha256\": \"e7611f07e8bb3c3e1e3b2c2851dd25c1e1108bd8c6d4128a31c54617c814eb5a\",\n    \"payload\": \"{\\\"magic\\\":\\\"ENV-ENC1\\\",\\\"kdf\\\":\\\"PBKDF2-SHA256\\\",\\\"iterations\\\":600000,\\\"salt\\\":\\\"AQIDBAUGBwgJCgsMDQ4PEA\\\",\\\"nonce\\\":\\\"AQIDBAUGBwgJCgsM\\\",\\\"ciphertext\\\":\\\"lFyT3p92pT56vOt7b-jCKO0-5mGYLfINAuV0L7gx20o\\\"}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Document pushed', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('notesRevision', json.revision);",
                  "});"
                ]
              }
            }
          ],
          "description": "First push for a non-primary document. `expectedRevision` must be null."
        },
        {
          "name": "5. Get head meta (notes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/documents/notes/head/meta",
            "description": "Lightweight head metadata — poll this before deciding to pull.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Head meta returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.environment.set('notesRevision', pm.response.json().revision);",
                  "});"
                ]
              }
            }
          ],
          "description": "Lightweight head metadata — poll this before deciding to pull."
        },
        {
          "name": "6. Get head (notes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{relayBaseUrl}}/namespaces/{{namespaceId}}/documents/notes/head",
            "description": "Full envelope for import when revision differs from local state.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "Full envelope for import when revision differs from local state."
        }
      ]
    },
