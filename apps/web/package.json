{
  "name": "@senkronla/web",
  "version": "0.1.7",
  "private": true,
  "description": "Senkronla operator portal and developer documentation",
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "next start",
    "test": "echo \"No tests yet\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:postman": "tsx scripts/generate-postman.ts",
    "generate:search": "node --import tsx scripts/generate-search-index.ts",
    "prebuild": "pnpm generate:postman && pnpm generate:search"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "minisearch": "^7.2.0",
    "next": "^15.1.3",
    "next-intl": "^3.26.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
