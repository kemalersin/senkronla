# Local development — copy to .env and adjust
# cp .env.example .env

# Optional: path to YAML config (see packages/server/config.example.yaml)
# ESR_CONFIG_PATH=./config.yaml

# Postgres (default matches docker compose --profile bundled-db)
ESR_DATABASE_URL=postgresql://esr:esr@localhost:5432/esr

# API
ESR_PUBLIC_URL=http://localhost:8080
ESR_ADMIN_TOKEN=change-me-use-a-long-random-token-min-32-chars
ESR_UNLOCK_HMAC_SECRET=change-me-unlock-hmac-secret-min-32
ESR_BLOB_PATH=./data/blobs
ESR_DEFAULT_FREE_DEVICE_LIMIT=2
ESR_ON_LIMIT_MODE=payment
ESR_MAX_ENVELOPE_BYTES=52428800
# ESR_MAX_DOCUMENTS_PER_NAMESPACE=32
# ESR_REVISION_RETENTION_DAYS=0   # auto-purge non-head revisions older than N days after each push (0 = keep all)
# ESR_REVISION_RETENTION_COUNT=0  # keep last N revisions per document after each push (0 = off; head counts toward N)
# ESR_ALLOWED_DOCUMENT_IDS=primary,settings
ESR_WEBSOCKET_ENABLED=true
ESR_CORS_ORIGINS=*

# Application registry (v1.3 — optional; apps.enabled defaults to false)
# ESR_APPS__ENABLED=false
# ESR_APPS__REGISTRATION_MODE=operator_managed
# ESR_APPS__ALLOW_LOCALHOST_ORIGINS=true
# ESR_APPS__LEGACY_DEFAULT_APP_ID=esr_app_primary
# ESR_APPS__NATIVE__REQUIRE_CLIENT_SECRET=false
# ESR_APPS__NATIVE__REQUIRE_MANUAL_REVIEW=true
# ESR_DEVELOPER_JWT_SECRET=change-me-long-random-min-32-chars
# ESR_APPS__DEVELOPER_PORTAL__JWT_SECRET=change-me-long-random-min-32-chars
# ESR_APPS__LIMITS__PER_APP__NAMESPACES_PER_DAY=100
# ESR_APPS__LIMITS__PER_APP__PAIRING_TOKENS_PER_HOUR=30
# ESR_APPS__LIMITS__PER_APP__RECOVER_PER_HOUR=5
# verification.*, limits.perDeveloper.*, developerPortal.enabled/sessionTtlHours/requireEmailVerification, seed — YAML only (config.example.yaml)

# SMTP mail (developer email verification and password reset)
# ESR_MAIL__ENABLED=false
# ESR_MAIL__FROM=noreply@example.com
# ESR_MAIL__FROM_NAME=Senkronla
# ESR_MAIL__WEB_BASE_URL=http://localhost:3000
# ESR_SMTP__HOST=smtp.example.com
# ESR_SMTP__PORT=587
# ESR_SMTP__SECURE=false
# ESR_SMTP__USER=
# ESR_SMTP__PASSWORD=

# Rate limits (see packages/server/config.example.yaml)
ESR_RATE_LIMIT_ENABLED=true
ESR_RECOVER_PER_HOUR=5
ESR_PAIRING_PER_HOUR=20
ESR_PAIRING_TOKENS_PER_HOUR=30
ESR_PUSH_PER_HOUR_PER_DEVICE=120
ESR_GENERAL_PER_MINUTE_PER_IP=300
# ESR_DEVELOPER_AUTH_MAIL_PER_HOUR_PER_IP=20
# ESR_DEVELOPER_AUTH_MAIL_PER_HOUR=5

# Web portal
NEXT_PUBLIC_API_URL=http://localhost:8080
