{
  "name": "@senkronla/cli",
  "version": "0.1.11",
  "description": "Senkronla operator CLI — unlock code generation and admin tools",
  "license": "MIT",
  "author": "Kemal Ersin",
  "homepage": "https://senkron.la/guides/esr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemalersin/senkronla.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kemalersin/senkronla/issues"
  },
  "keywords": [
    "senkronla",
    "esr",
    "cli",
    "operator",
    "unlock",
    "relay",
    "admin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "senkronla": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@senkronla/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
