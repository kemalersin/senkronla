{
  "name": "@senkronla/server",
  "version": "0.1.11",
  "description": "Senkronla Envelope Sync Relay — Fastify REST API and WebSocket hub",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "smoke:faz3": "tsx src/scripts/faz3-smoke.ts",
    "smoke:faz4": "tsx src/scripts/faz4-smoke.ts",
    "smoke:faz5": "tsx src/scripts/faz5-smoke.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/db/migrate.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.2.0",
    "@senkronla/protocol": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "nodemailer": "^8.0.10",
    "pg": "^8.13.1",
    "ulid": "^2.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.25.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "ws": "^8.21.0"
  }
}
