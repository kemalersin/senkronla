{
  "name": "@senkronla/client",
  "version": "0.1.16",
  "description": "Senkronla client SDK — RelayClient, SyncEngine, EsrSync facade",
  "license": "MIT",
  "author": "Kemal Ersin",
  "homepage": "https://senkron.la/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemalersin/senkronla.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/kemalersin/senkronla/issues"
  },
  "keywords": [
    "senkronla",
    "esr",
    "sync",
    "client",
    "sdk",
    "offline-first",
    "websocket",
    "relay"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@senkronla/protocol": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
