{
  "name": "@senkronla/client",
  "version": "0.1.6",
  "description": "Senkronla client SDK — RelayClient, SyncEngine, EsrSync facade",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@senkronla/protocol": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
