{
  "name": "@senkronla/protocol",
  "version": "0.1.14",
  "description": "ESR-DOC1 envelope protocol, crypto helpers, and identity utilities",
  "license": "MIT",
  "author": "Kemal Ersin",
  "homepage": "https://senkron.la/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemalersin/senkronla.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/kemalersin/senkronla/issues"
  },
  "keywords": [
    "senkronla",
    "esr",
    "sync",
    "envelope",
    "zero-knowledge",
    "offline-first",
    "cryptography"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./recovery-phrase": {
      "types": "./dist/recovery-phrase.d.ts",
      "import": "./dist/recovery-phrase.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^1.5.4",
    "hash-wasm": "^4.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
