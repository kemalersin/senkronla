# Copy to .env and adjust for your environment.
# cp docker/.env.example .env

# ── Database mode ─────────────────────────────────────────────────────────────
# Bundled Postgres (docker compose --profile bundled-db up):
#   Leave ESR_DATABASE_URL unset — default points to compose postgres service.
#
# External Postgres:
#   Set ESR_DATABASE_URL to your existing instance and run without bundled-db profile.
#   Example (Postgres on host, API in Docker):
#   ESR_DATABASE_URL=postgresql://esr:secret@host.docker.internal:5432/esr

# ESR_DATABASE_URL=postgresql://user:password@host.docker.internal:5432/esr

POSTGRES_USER=esr
POSTGRES_PASSWORD=esr
POSTGRES_DB=esr
POSTGRES_PUBLISH_PORT=5432

# ── API ───────────────────────────────────────────────────────────────────────
ESR_PUBLISH_PORT=8080
ESR_PUBLIC_URL=http://localhost:8080
ESR_ADMIN_TOKEN=change-me-use-a-long-random-token-min-32-chars
ESR_UNLOCK_HMAC_SECRET=change-me-unlock-hmac-secret-min-32
ESR_DEFAULT_FREE_DEVICE_LIMIT=2
ESR_ON_LIMIT_MODE=payment
ESR_WEBSOCKET_ENABLED=true
ESR_CORS_ORIGINS=*

# ── Web portal ────────────────────────────────────────────────────────────────
WEB_PUBLISH_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
