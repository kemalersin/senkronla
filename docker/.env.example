# Docker Compose uses the repo-root .env — not a file in this directory.
#
#   cp .env.example .env          # from repo root
#   docker compose --project-directory . -f docker/docker-compose.yml --env-file .env --profile bundled-db up --build
#
# See ../.env.example for all variables (API secrets, ESR_BLOB_PATH, rate limits, Postgres ports, etc.).
